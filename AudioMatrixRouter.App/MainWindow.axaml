<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:chrome="using:Avalonia.Controls.Chrome"
        x:Class="AudioMatrixRouter.App.MainWindow"
        Title="Audio Router Matrix"
        Width="1100" Height="720"
        MinWidth="900" MinHeight="600"
        Background="#101113"
        WindowDecorations="BorderOnly"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="-1">

  <Window.Resources>
    <!-- Design tokens — see docs/DESIGN-REFERENCE.md §2. Placeholder set; the full
         ThemeService (preset mixing) replaces these static values. -->
    <SolidColorBrush x:Key="Bg" Color="#101113" />
    <SolidColorBrush x:Key="Surface" Color="#1A1D22" />
    <SolidColorBrush x:Key="Panel" Color="#16181D" />
    <SolidColorBrush x:Key="Line" Color="#39404D" />
    <SolidColorBrush x:Key="Text" Color="#DBE0E8" />
    <SolidColorBrush x:Key="Muted" Color="#9AA4B2" />
    <SolidColorBrush x:Key="Accent" Color="#2DD4BF" />
    <SolidColorBrush x:Key="AccentDim" Color="#12332F" />
    <SolidColorBrush x:Key="AccentLine" Color="#2B6F66" />
  </Window.Resources>

  <DockPanel>
    <!-- ===== Header IS the title bar (constraint #3). Avalonia 12 element roles:
         TitleBar gives native drag + double-click-maximize; interactive children
         opt out with the User role. ===== -->
    <Border DockPanel.Dock="Top" Background="{StaticResource Panel}"
            BorderBrush="#23272E" BorderThickness="0,0,0,1"
            Name="HeaderBar" MinHeight="56"
            chrome:WindowDecorationProperties.ElementRole="TitleBar">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto">

        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12"
                    Margin="16,0,0,0" VerticalAlignment="Center">
          <!-- brand grid icon -->
          <UniformGrid Columns="3" Rows="3" Width="24" Height="24">
            <Border Background="{StaticResource Accent}" Margin="1" CornerRadius="1" />
            <Border Background="{StaticResource Accent}" Margin="1" CornerRadius="1" Opacity="0.35" />
            <Border Background="{StaticResource Accent}" Margin="1" CornerRadius="1" />
            <Border Background="{StaticResource Accent}" Margin="1" CornerRadius="1" Opacity="0.35" />
            <Border Background="{StaticResource Accent}" Margin="1" CornerRadius="1" />
            <Border Background="{StaticResource Accent}" Margin="1" CornerRadius="1" Opacity="0.35" />
            <Border Background="{StaticResource Accent}" Margin="1" CornerRadius="1" />
            <Border Background="{StaticResource Accent}" Margin="1" CornerRadius="1" Opacity="0.35" />
            <Border Background="{StaticResource Accent}" Margin="1" CornerRadius="1" />
          </UniformGrid>

          <StackPanel Spacing="2" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="AUDIO MATRIX PATCH" FontSize="14" FontWeight="SemiBold"
                         LetterSpacing="0.8" Foreground="{StaticResource Text}" />
              <Border CornerRadius="999" BorderBrush="{StaticResource AccentLine}"
                      BorderThickness="1" Background="{StaticResource AccentDim}"
                      Padding="8,2" VerticalAlignment="Center">
                <TextBlock Name="VersionText" Text="v0.0.0" FontSize="10" FontWeight="Bold"
                           Foreground="#BFE9E2" />
              </Border>
            </StackPanel>
            <TextBlock Name="StatusText" Text="Standby" FontSize="11"
                       Foreground="{StaticResource Muted}" />
          </StackPanel>
        </StackPanel>

        <!-- empty space = drag region (wired in code-behind) -->
        <Border Grid.Column="1" Background="Transparent" Name="DragRegion" />

        <Border Grid.Column="2" Width="34" Height="34" Margin="0,0,6,0"
                VerticalAlignment="Center" CornerRadius="7"
                BorderBrush="{StaticResource Line}" BorderThickness="1"
                Background="{StaticResource Surface}">
          <TextBlock Text="⚙" FontSize="14" Foreground="{StaticResource Muted}"
                     HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>

        <!-- caption buttons -->
        <StackPanel Grid.Column="3" Orientation="Horizontal"
                    chrome:WindowDecorationProperties.ElementRole="User">
          <Button Name="MinButton" Classes="caption" Content="—" />
          <Button Name="MaxButton" Classes="caption" Content="▢" />
          <Button Name="CloseButton" Classes="caption close" Content="✕" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- ===== Body: Core-linkage proof — live device enumeration ===== -->
    <Border Padding="16">
      <Grid RowDefinitions="Auto,*" ColumnDefinitions="*,*">
        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,12"
                   Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap"
                   Text="Avalonia scaffold — engine linked from AudioMatrixRouter.Core. Next: MatrixControl / DrumControl / MeterBars / HeaderStrip per docs/AVALONIA-MIGRATION.md §2.2." />

        <Border Grid.Row="1" Grid.Column="0" Margin="0,0,8,0"
                Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
                BorderThickness="1" CornerRadius="8" Padding="12">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="INPUT DEVICES" FontSize="11"
                       FontWeight="Bold" LetterSpacing="0.6"
                       Foreground="{StaticResource Muted}" Margin="0,0,0,8" />
            <ItemsControl Name="InputList" />
          </DockPanel>
        </Border>

        <Border Grid.Row="1" Grid.Column="1" Margin="8,0,0,0"
                Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
                BorderThickness="1" CornerRadius="8" Padding="12">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="OUTPUT DEVICES" FontSize="11"
                       FontWeight="Bold" LetterSpacing="0.6"
                       Foreground="{StaticResource Muted}" Margin="0,0,0,8" />
            <ItemsControl Name="OutputList" />
          </DockPanel>
        </Border>
      </Grid>
    </Border>
  </DockPanel>

  <Window.Styles>
    <Style Selector="Button.caption">
      <Setter Property="Width" Value="44" />
      <Setter Property="Height" Value="56" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#8B93A1" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.caption:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#22262D" />
    </Style>
    <Style Selector="Button.caption.close:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#B1332C" />
      <Setter Property="Foreground" Value="White" />
    </Style>
  </Window.Styles>
</Window>
