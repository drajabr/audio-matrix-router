<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- Same root namespace as the host apps: the engine moved here verbatim
         (AudioMatrixRouter.Audio / AudioMatrixRouter.Models) with zero code churn. -->
    <RootNamespace>AudioMatrixRouter</RootNamespace>
    <Platforms>x64</Platforms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>NU1701;CS0618</NoWarn>
    <Version Condition="'$(Version)' == ''">0.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.3.0" />
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>
</Project>
